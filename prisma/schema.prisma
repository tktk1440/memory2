// Prisma schema for the psychology-based matchmaking app.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile Profile?

  responses QuestionResponse[]

  likesGiven    Like[] @relation("LikesGiven")
  likesReceived Like[] @relation("LikesReceived")

  passesGiven Pass[] @relation("PassesGiven")

  matchesAsA Match[] @relation("MatchUserA")
  matchesAsB Match[] @relation("MatchUserB")

  messages Message[]
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  age      Int
  gender   String // man | woman | nonbinary
  seeking  String // comma-separated subset of: man,woman,nonbinary
  bio      String @default("")
  location String @default("")

  onboardingComplete    Boolean @default(false)
  questionnaireComplete Boolean @default(false)

  // --- Big Five personality (Mini-IPIP, Donnellan et al. 2006), 0-100 scale ---
  openness          Float?
  conscientiousness Float?
  extraversion      Float?
  agreeableness     Float?
  neuroticism       Float?

  // --- Adult attachment (adapted ECR-S, Wei et al. 2007), 0-100 scale ---
  attachmentAnxiety   Float?
  attachmentAvoidance Float?
  attachmentStyle     String? // secure | anxious | avoidant | fearful

  // --- Core values (Schwartz-inspired relationship values), JSON: {value: 0-100} ---
  valuesJson String?

  // --- Love languages (Chapman, 1992), JSON: {language: 0-100} ---
  loveLanguagesJson String?

  // --- Relationship goals & lifestyle (compatibility hard/soft filters) ---
  relationshipGoal   String? // long_term | marriage | short_term | casual | unsure
  wantsChildren      String? // yes | no | unsure | have_want_more | have_dont_want_more
  religion           String  @default("")
  religionImportance Int     @default(1) // 1-5
  politics           String  @default("")
  politicsImportance Int     @default(1) // 1-5
  smoking            String  @default("never") // never | sometimes | regularly
  drinking           String  @default("never") // never | socially | regularly
  exercise           String  @default("sometimes") // never | sometimes | often

  minAgePref Int @default(18)
  maxAgePref Int @default(99)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionResponse {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  value      Int
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  from       User     @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Pass {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  from       User     @relation("PassesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Match {
  id                 String   @id @default(cuid())
  userAId            String
  userBId            String
  userA              User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB              User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  compatibilityScore Float
  scoreBreakdownJson String   @default("{}")
  createdAt          DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}
